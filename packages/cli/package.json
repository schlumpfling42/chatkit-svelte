{
  "name": "create-chatkit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "npx create-chatkit my-chat-app — scaffolds a bare Vite+Svelte app wired to @chatkit/svelte + @chatkit/ui with chosen plugins/theme. SvelteKit scaffolding is not yet supported.",
  "type": "module",
  "bin": {
    "create-chatkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "vite build --mode lib",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schlumpfling42/chatkit-svelte.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/schlumpfling42/chatkit-svelte/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/schlumpfling42/chatkit-svelte/issues"
  }
}
